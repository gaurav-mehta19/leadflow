APP_ENV=development
APP_NAME=LeadFlow API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://leadflow:leadflow@localhost:5432/leadflow
TEST_DATABASE_URL=postgresql+asyncpg://leadflow:leadflow@localhost:5432/leadflow_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
CORS_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_FORMAT=console
